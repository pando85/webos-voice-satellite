# Pinned upstream sources for the static aarch64 tools.
# Sourced by build.sh (host) and container-build.sh (container). POSIX sh syntax.

# Base image: Alpine (musl). Pinned by multi-arch index digest; the build runs
# the linux/arm64 and linux/arm/v7 variants under qemu-user binfmt on x86_64 hosts.
ALPINE_IMAGE="alpine:3.23@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63"

